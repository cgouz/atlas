APP_ENV=local

HTTP_HOST=0.0.0.0
HTTP_PORT=8090

DB_HOST=localhost
DB_PORT=5432
DB_NAME=atlas
DB_USER=atlas
DB_PASSWORD=atlas
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=20

RESOURCES_DIR=src/resources
MIGRATE_ON_START=true
SEED_ON_START=true
SEED_COUNTRIES=UZ

SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SEC=60
SCHEDULER_MAX_SITES=2
SCHEDULER_FAILURE_RETRY_SEC=1800

CRAWL_MAX_SITES=8
CRAWL_MAX_SITES_PER_COUNTRY=4

CRAWLER_WORKERS=4
CRAWLER_TIMEOUT_SEC=30
CRAWLER_MAX_BODY_BYTES=5242880
CRAWLER_USER_AGENT=ATLASBot/0.1 (+https://example.org/bot)

LLM_RUNTIME=llamacpp
# llama-server on another machine: LLM_BASE_URL=http://<host>:8080/v1
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=qwen3-8b-q8_0
# Sent as "Authorization: Bearer <key>"; must match LLAMA_API_KEY of llama-server.
# Better set it as a real environment variable than here, so it is not committed.
LLM_API_KEY=
LLM_TIMEOUT_SEC=300
LLM_WORKERS=16
LLM_MAX_RETRIES=2
LLM_MAX_INPUT_CHARS=12000
LLM_MAX_TOKENS=6144

LLM_MODELS_DIR=models
LLM_MODEL_PATH=models/qwen3-8b/Qwen3-8B-Q8_0.gguf
